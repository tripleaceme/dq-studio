{
  "name": "dq-studio",
  "displayName": "Data Quality Studio — GE & Soda Core",
  "description": "Visual builder that generates Great Expectations and Soda Core data quality tests from your live database — or local CSV/Excel/Parquet files — no code required.",
  "version": "0.4.0",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tripleaceme/dq-studio.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "data quality",
    "great expectations",
    "soda core",
    "sodacl",
    "dbt",
    "data testing",
    "data validation",
    "modern data stack",
    "data engineering",
    "postgres",
    "snowflake",
    "bigquery",
    "duckdb",
    "csv",
    "excel",
    "xlsx",
    "parquet"
  ],
  "publisher": "tripleaceme",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dq-builder",
          "title": "Data Quality",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dq-builder": [
        {
          "id": "dq-schema-tree",
          "name": "Tables"
        }
      ]
    },
    "commands": [
      {
        "command": "dq-builder.openTable",
        "title": "Open Test Builder"
      },
      {
        "command": "dq-builder.refreshTree",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "dq-builder.configureConnection",
        "title": "Configure Connection",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dq-builder.refreshTree",
          "when": "view == dq-schema-tree",
          "group": "navigation@1"
        },
        {
          "command": "dq-builder.configureConnection",
          "when": "view == dq-schema-tree",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Data Quality Studio",
      "properties": {
        "dq-studio.credentialsPath": {
          "type": "string",
          "default": "",
          "description": "Path to your credentials file — dbt profiles.yml, BigQuery service account JSON, or .env file. Overrides the default ~/.dbt/profiles.yml lookup. Supports ~ for home directory."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "vsce package --no-dependencies",
    "compile": "tsc -p ./",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^8.3.1",
    "hyparquet": "^1.26.2",
    "js-yaml": "^4.1.0",
    "pg": "^8.11.3",
    "snowflake-sdk": "^2.4.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.3.0"
  }
}
